# =============================================================================
# VeriScan National Digital Forensics Platform - Environment Configuration
# =============================================================================
# Copy this file to:
#   - `.env.local` for local development
#   - Vercel Project Settings > Environment Variables for the Frontend
#   - Render Dashboard > Environment Variables for the Fast Check Backend
#   - n8n Credentials / Environment Variables for the Webhook Orchestrator
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND: Vercel / Next.js / Vite Client Configuration
# -----------------------------------------------------------------------------
# Note: Both NEXT_PUBLIC_* and VITE_* prefixes are supported so your build
# works seamlessly whether deployed via Next.js or Vite.

# Your Supabase Project HTTPS URL (Found in Supabase: Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Client Key (Public JWT; safe for client bundles)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Public URL of your deployed Render Fast Check Service (or localhost:8000 locally)
NEXT_PUBLIC_FAST_CHECK_URL=https://veriscan-fast-check.onrender.com
VITE_FORENSIC_WORKER_URL=https://veriscan-fast-check.onrender.com

# Application Identifier
NEXT_PUBLIC_APP_ID=veriscan-national-forensics
VITE_APP_ID=veriscan-national-forensics


# -----------------------------------------------------------------------------
# 2. BACKEND: FastAPI / Render Microservice (`services/forensic-worker`)
# -----------------------------------------------------------------------------

# Port dynamically set by Render ($PORT). Defaults to 8000 locally.
PORT=8000

# (Optional) Shared secret for HMAC-SHA256 network isolation.
# If configured, callers to /analyze must provide header `X-VeriScan-Signature`.
# Leave empty or omit during initial setup to allow open internal orchestration.
VERISCAN_SECRET_KEY=

# Local path to UIDAI public X.509 certificate for offline Aadhaar QR verification.
UIDAI_PUBLIC_CERT_PATH=certs/uidai_public_cert.cer

# Set to "true" in dev/testing environments without GPU weights to use synthetic inference.
# In production with real PyTorch model checkpoints, set to "false".
ALLOW_SYNTHETIC_MODEL_INFERENCE=false

# (Optional) PyTorch model weight filepaths for advanced GPU forensic checks.
TRUFOR_CHECKPOINT=
CATNET_CHECKPOINT=

# (Optional) Hugging Face API Token for AI-generated face/image detection.
HF_API_TOKEN=


# -----------------------------------------------------------------------------
# 3. ORCHESTRATOR: n8n Webhook & Worker Credentials
# -----------------------------------------------------------------------------
# Configure these in n8n Workflow Credentials / Environment:

# Supabase API endpoint
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Secret Service Role Key (NEVER expose to frontend; used by n8n to update rows)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# Base URL for the Render Fast Check Web Service (used in n8n HTTP Request node)
LIGHTWEIGHT_URL=https://veriscan-fast-check.onrender.com

# (Optional) GPU service URL if running TruFor / CAT-Net in a separate GPU container
GPU_URL=https://veriscan-gpu-worker.onrender.com


# -----------------------------------------------------------------------------
# 4. TESTING: Automated Integration Test Credentials (`scripts/e2e_live_test.py`)
# -----------------------------------------------------------------------------
TEST_USER_EMAIL=analyst.test@veriscan.in
TEST_USER_PASSWORD=YourSecurePassword123!


# -----------------------------------------------------------------------------
# 5. NODE.JS SERVER (Optional: if deploying server/ Express / tRPC gateway)
# -----------------------------------------------------------------------------
# PostgreSQL or MySQL database connection URL
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Secret key for local JWT session cookies (min 32 characters)
JWT_SECRET=veriscan-production-jwt-secret-key-replace-in-production

# Node environment
NODE_ENV=production
